{
  "name": "dsh-workaround-git",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) plugin: batch git operations across every repo in a workspace — status, sync, per-repo commits, and push, for parallel development across several projects.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roshenn/dsh-workaround-git.git"
  },
  "homepage": "https://github.com/Roshenn/dsh-workaround-git#readme",
  "bugs": {
    "url": "https://github.com/Roshenn/dsh-workaround-git/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./git": "./lib/git.mjs",
    "./format": "./lib/format.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "git",
    "batch",
    "multi-repo",
    "workspace",
    "parallel-development",
    "sync"
  ]
}
